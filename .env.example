# ============================================================
# ARGOS BOT — ENVIRONMENT VARIABLES SHABLONI
# ============================================================
# Ushbu shablon faqat namuna sifatida. Haqiqiy qiymatlarni
# Railway dashboardidagi "Variables" bo'limiga qo'shing.
# Lokalda sinash uchun shu fayldan nusxa olib ".env" deb saqlang
# va o'z qiymatlaringizni kiriting (.env fayli gitignore'da).
# ============================================================

# --- Telegram Bot (bot.py uchun) ---
# @BotFather'da yangi bot yaratib, undan olingan token
BOT_TOKEN=000000000:AAAA-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Mini App URL — Railway domeni yoki custom domen
MINI_APP_URL=https://argos-bot-production.up.railway.app/static/index.html

# --- Telethon (export_quiz.py uchun, ixtiyoriy) ---
# my.telegram.org > API development tools'dan olinadi
API_ID=12345678
API_HASH=0000000000000000000000000000000000

# Telegram kanal username (yoki "-100..." formatdagi private ID)
KANAL=@argos_testlarim

# Add-questions API endpoint
API_URL=https://argos-bot-production.up.railway.app/api/add_questions
